{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-scaffolding.kaeferbrasil.com.br",
        "EXPO_PUBLIC_REQUEST_TIMEOUT_MS": "30000"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-scaffolding.kaeferbrasil.com.br",
        "EXPO_PUBLIC_REQUEST_TIMEOUT_MS": "30000"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
