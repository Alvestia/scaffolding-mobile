{
  "expo": {
    "name": "Scaffold Mobile",
    "slug": "scaffold-kaefer",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/brand/app-icon.png",
    "scheme": "scaffoldingmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/brand/app-icon.png",
      "bundleIdentifier": "br.com.rip.scaffolding"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2C414A",
        "foregroundImage": "./assets/images/brand/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.rip.scaffolding",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2C414A",
          "image": "./assets/images/brand/kaefer-wordmark-white.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita que o Scaffold Mobile use o Face ID para desbloquear sua sessao."
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/with-android-security",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permita que o Scaffold Mobile use a câmera para registrar evidências de execuções e desvios.",
          "photosPermission": "Selecione fotos para anexar como evidências de execuções e desvios no Scaffold Mobile.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ef252e8-b451-4e3c-85b2-b9a0c1dfad6e"
      }
    },
    "owner": "tiagoalves.viana"
  }
}
